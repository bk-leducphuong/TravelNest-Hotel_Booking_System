NODE_ENV=delelopment

PORT=3000
CLIENT_HOST=http://localhost:5173
ADMIN_CLIENT_HOST=http://localhost:8000
SUPERADMIN_CLIENT_HOST=http://localhost:8100
JWT_SECRET=your_jwt_secret_key
INTERNAL_SERVICE_TOKEN=your_internal_service_token

# Rate limiting (global per-IP throttle). Set RATE_LIMIT_ENABLED=false for local
# development / e2e runs; keep it true in production.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_WRITE_MAX=60

# Mysql database informations
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=changeme
DB_NAME=travelnest

# Optional credentials with CREATE DATABASE rights, used only by
# `scripts/dump-schema.js --from-sync` and `scripts/check-schema-drift.js` to
# create/drop throwaway databases. Defaults to DB_USER/DB_PASSWORD when unset.
# In the local docker-compose only root can create databases, so set DB_ADMIN_USER=root.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# Analytics service
ANALYTICS_SERVICE_URL=http://localhost:8081
ANALYTICS_SERVICE_TIMEOUT_MS=2000

# Redis informations
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME= 
REDIS_PASSWORD=
REDIS_DB=1
REDIS_URL=redis://localhost:6379/1
TRENDING_HOTELS_CACHE_TTL=2m
TRENDING_DESTINATIONS_CACHE_TTL=5m

# IP geolocation (Cloudflare visitor-location headers), cache TTL in seconds
IP_GEO_CACHE_TTL_SECONDS=3600

# Set when the API runs behind a trusted proxy (e.g. Cloudflare Tunnel -> Traefik)
# TRUST_PROXY=1

# Rate limiting (see server/middlewares/rate-limitter.middleware.js).
# RATE_LIMIT_ENABLED=false disables throttling entirely — prefer the allowlist
# below, which exempts only the listed addresses and keeps everyone else limited.
# Client identity comes from Cloudflare's CF-Connecting-IP when present.
# RATE_LIMIT_ALLOWLIST=203.0.113.10,198.51.100.0/24,2001:db8::/32

# Session secret key
SESSION_SECRET_KEY=secretkey

# node mailer
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# email validation (using abtract api https://www.abstractapi.com/)
EMAIL_VALIDATION_API_KEY=

# otp verification over sms (using inforbip https://portal.infobip.com/homepage)
INFOBIP_API_KEY=
INFOBIP_BASE_URL=

# MINIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=uploads
MINIO_USE_SSL=false
# Optional: sign browser-facing chat attachment URLs for a public host.
# Defaults to MINIO_ENDPOINT/MINIO_PORT when unset.
# MINIO_PUBLIC_ENDPOINT=
# MINIO_PUBLIC_PORT=
# MINIO_PUBLIC_USE_SSL=
# CHAT_ATTACHMENT_URL_TTL_SECONDS=3600

# stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payout automation (Stripe Connect transfers to hotel owners)
# Generation creates pending payouts; processing sends the Stripe transfer.
# Keep both disabled until Stripe test-mode verification is complete.
PAYOUT_AUTO_GENERATE=false
PAYOUT_AUTO_PROCESS=false
PAYOUT_GENERATION_INTERVAL_MS=86400000
PAYOUT_PROCESSING_INTERVAL_MS=300000
PAYOUT_HOLD_DAYS=7
PAYOUT_MIN_AMOUNT=0
PAYOUT_STALE_MINUTES=60
PAYOUT_BATCH_SIZE=500
PAYOUT_RECOVERY_BATCH_SIZE=50

# OAuth
# Google SSO is brokered by Keycloak: these values feed the realm's identity
# provider (npm run keycloak:configure-google) rather than a Passport strategy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

API_BASE_URL=http://localhost:3000/api/v1
EXTERNAL_BASE_URL=http://localhost:3000

WORKER_HEALTH_PORT=4001

# Keycloak
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=travelnest
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ISSUER=http://localhost:8080/realms/travelnest
KEYCLOAK_CLIENT_ID=travelnest-web
KEYCLOAK_AUDIENCE=travelnest-web
KEYCLOAK_CLOCK_SKEW_SECONDS=60
KEYCLOAK_PUBLIC_KEY_PEM=
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Local CLI helpers for AI/debugging.
# The dev docker-compose publishes MySQL on host port 3307; keep DB_PORT at
# the application port you actually use and override the CLI separately.
MYSQL_CLI_HOST=localhost
MYSQL_CLI_PORT=3307
MYSQL_CLI_USER=${DB_USER}
MYSQL_CLI_PASSWORD=${DB_PASSWORD}
MYSQL_CLI_DATABASE=${DB_NAME}

REDIS_CLI_HOST=${REDIS_HOST}
REDIS_CLI_PORT=${REDIS_PORT}
REDIS_CLI_DB=${REDIS_DB}

MINIO_CLI_ALIAS=travelnest
MINIO_CLI_ENDPOINT=${MINIO_ENDPOINT}
MINIO_CLI_PORT=${MINIO_PORT}
MINIO_CLI_BUCKET=${MINIO_BUCKET}


# Estimated refund arrival after provider processing (business days)
REFUND_ETA_MIN_BUSINESS_DAYS=5
REFUND_ETA_MAX_BUSINESS_DAYS=10

# Promotion rollout flags (default true). Disabling a mode stops new
# application in search/detail/hold/preview/booking; existing bookings and
# redemptions continue to process normally.
PROMOTION_AUTOMATIC_ENABLED=true
PROMOTION_CODE_ENABLED=true
PROMOTION_RECONCILE_INTERVAL_MS=300000
PROMOTION_RECONCILE_LIMIT=100

# Guest <-> hotel messaging. Guests may keep posting for this many days after
# check-out; reading history and hotel replies are never time-boxed.
CHAT_SEND_WINDOW_DAYS=30
