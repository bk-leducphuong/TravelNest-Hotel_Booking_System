# ===========================================
# TravelNest Infra - copy to .env and fill in
# ===========================================

# ---------- Dev stack (docker-compose.dev.yml) ----------
DB_NAME=travelnest
DB_USER=admin
DB_PASSWORD=changeme
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Expose matching API-side Keycloak defaults for local compose usage.
KEYCLOAK_ISSUER=http://localhost:8080/realms/travelnest
KEYCLOAK_CLIENT_ID=travelnest-web
KEYCLOAK_AUDIENCE=travelnest-web
KEYCLOAK_CLOCK_SKEW_SECONDS=60

# Google SSO identity provider, interpolated into the Keycloak realm template
# on a fresh import. Set the same pair in server/.env.development for the
# existing-realm reconciliation script (npm run keycloak:configure-google).
# Leave empty to keep the Google button non-functional; set both to enable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# MongoDB analytics
MONGODB_DATABASE=travelnest_analytics

# NATS JetStream
NATS_URL=nats://nats:4222
NATS_STREAM=TRAVELNEST_ANALYTICS
NATS_CLIENT_NAME=travelnest-api

# Mongo Express GUI
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=changeme

