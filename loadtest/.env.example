# Copy to loadtest/.env (gitignored) and fill in what you need.
#
# The script also reads BYPASS_TOKEN and STRIPE_SECRET_KEY from
# deploy/k8s/.env.prod when they are not set here, so on this machine the only
# value you actually have to provide is LOADTEST_PASSWORD.

# --- rate-limiter exemption -------------------------------------------------
# Optional. Without it a ramp is capped at 300 requests / 15 min and will abort.
# Defaults to RATE_LIMIT_BYPASS_TOKEN from deploy/k8s/.env.prod.
# BYPASS_TOKEN=

# --- Stripe (test mode only) ------------------------------------------------
# Only needed for `--pay` (funnel mode). A live key is rejected.
# Defaults to STRIPE_SECRET_KEY from deploy/k8s/.env.prod.
# STRIPE_SECRET_KEY=

# --- Keycloak guest used by the funnel --------------------------------------
KEYCLOAK_URL=https://keycloak.trestay.com
LOADTEST_USERNAME=loadtest@trestay.com
LOADTEST_PASSWORD=
