server/infra/.env

# Local infra runtime data (MinIO objects, Elasticsearch indices). Keep the
# .gitkeep placeholders, ignore the generated contents.
server/infra/minio-data/*
!server/infra/minio-data/.gitkeep
server/infra/minio-data-test/
server/infra/elasticsearch/data/*
!server/infra/elasticsearch/data/.gitkeep

server/secrets/*

# Services
services/*/.env

# Wiki clone (nested .wiki directory)
*.wiki/

# Local AI tooling config
.claude/

# SOPS/age private key and plaintext prod/local values (never commit)
deploy/k8s/.age/
deploy/k8s/.env.prod
deploy/k8s/.env.local


# Playwright MCP session artifacts
.playwright-mcp/
