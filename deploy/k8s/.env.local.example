# travelnest.local
#
# Copy to deploy/k8s/.env.local (gitignored) and fill in local values, then run
#   deploy/scripts/secrets/seal-local-secrets.sh
# to render + encrypt the local secret.template.yaml files.
#
# Every variable referenced by a LOCAL secret.template.yaml must be present.
# Values may be blank for optional settings, but the variable itself must be
# defined, otherwise sealing fails loudly.

# --- Core database (must match for mysql + api + worker + media + notification) ---
DB_PASSWORD=

# --- API / sessions ---
JWT_SECRET=
SESSION_SECRET_KEY=
INTERNAL_SERVICE_TOKEN=

# --- MongoDB (local dev manifest: deploy/k8s/local/mongodb) ---
MONGODB_URI=mongodb://mongodb:27017/travelnest_analytics

# --- Elasticsearch (local dev manifest: deploy/k8s/local/elasticsearch) ---
ELASTICSEARCH_ENDPOINT=http://elasticsearch:9200
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
ELASTICSEARCH_API_KEY=

# --- SMTP (blank/local is fine; no mailpit manifest in-cluster yet) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# --- Third-party APIs (dummy locally) ---
EMAIL_VALIDATION_API_KEY=
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- MinIO ---
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Keycloak ---
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# PEM-encoded public key (keep the \n escapes; do not wrap in quotes).
# May be blank for a first pass; token verification needs the real realm key.
KEYCLOAK_PUBLIC_KEY_PEM=
