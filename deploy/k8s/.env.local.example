# travelnest.local
#
# Copy to deploy/k8s/.env.local (gitignored) and fill in local values, then run
#   deploy/scripts/secrets/seal-local-secrets.sh
# to render + encrypt the local secret.template.yaml files.
#
# Every variable referenced by a LOCAL secret.template.yaml must be present.
# Values may be blank for optional settings, but the variable itself must be
# defined, otherwise sealing fails loudly.
#
# Prefer a dummy non-empty value (e.g. "local-dev-unused") over a blank one:
# Kubernetes drops empty Secret stringData keys, which makes Argo CD report the
# Secret as permanently OutOfSync.

# --- Core database (must match for mysql + api + worker + media + notification) ---
DB_PASSWORD=

# --- API / sessions ---
JWT_SECRET=
SESSION_SECRET_KEY=
INTERNAL_SERVICE_TOKEN=

# --- MongoDB (in-cluster manifest: deploy/k8s/infra/mongodb) ---
MONGODB_URI=mongodb://mongodb:27017/travelnest_analytics

