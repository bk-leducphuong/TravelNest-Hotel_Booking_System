# travelnest.prod — self-contained single-node k3s cluster (Hetzner CAX21)
#
# Copy to deploy/k8s/.env.prod (gitignored) and fill in real values.
# deploy/scripts/secrets/seal-prod-secrets.sh renders the
# deploy/k8s/**/overlays/prod/secret.template.yaml files with these variables
# and encrypts the result with SOPS.
#
# Every variable referenced by a secret.template.yaml must be present.
# Values may be blank for optional settings (e.g. SMTP_USER), but the
# variable itself must be defined.
#
# MySQL, Redis and Keycloak run in-cluster (service DNS names below). Object
# storage is Cloudflare R2 (external).

# --- Core database (in-cluster MySQL) ---
DB_HOST=mysql
DB_PORT=3306
DB_PASSWORD=
DB_NAME=travelnest
DB_USER=travelnest

# --- Redis (in-cluster) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Full URL for the analytics service (Go). Must embed the password:
#   redis://:<REDIS_PASSWORD>@redis:6379/1
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/1

# --- API / sessions ---
JWT_SECRET=
SESSION_SECRET_KEY=
INTERNAL_SERVICE_TOKEN=

# --- Analytics service (in-cluster) ---
# Reuses the application DB password; the travelnest_analytics user only has DML
# on the two analytics tables (see infra/mysql/app-users.sql).
#   <user>:<password>@tcp(host:3306)/<database>?parseTime=true&loc=UTC
MYSQL_DSN=travelnest_analytics:<DB_PASSWORD>@tcp(mysql:3306)/travelnest?parseTime=true&loc=UTC

# --- Object storage (Cloudflare R2, external) ---
# The apps still read the S3-compatible MINIO_* variable names.
# Node services take a host + separate port.
MINIO_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
MINIO_PORT=443
MINIO_BUCKET=uploads
MINIO_USE_SSL=true
MINIO_REGION=auto
# The media service reads MINIO_ENDPOINT from this value; R2 uses the default
# HTTPS port, so no scheme and no port.
MEDIA_MINIO_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
# Public URL of the `uploads` bucket's R2 custom domain (no /uploads suffix).
PUBLIC_OBJECT_BASE_URL=https://media.trestay.com
# Used by api, worker and media (${S3_ACCESS_KEY}/${S3_SECRET_KEY}).
S3_ACCESS_KEY=<R2_TOKEN_ID>
S3_SECRET_KEY=<R2_TOKEN_SECRET>

# --- MySQL backup CronJob (same R2 account, `travelnest-backups` bucket) ---
R2_ACCOUNT_ID=<ACCOUNT_ID>
R2_ACCESS_KEY_ID=<R2_TOKEN_ID>
R2_SECRET_ACCESS_KEY=<R2_TOKEN_SECRET>

# --- SMTP ---
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# --- Third-party APIs ---
EMAIL_VALIDATION_API_KEY=
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=


# --- Keycloak (in-cluster, backed by in-cluster MySQL) ---
KC_DB_URL_HOST=mysql
KC_DB_URL_PORT=3306
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# PEM-encoded public key (keep the \n escapes; do not wrap in quotes)
KEYCLOAK_PUBLIC_KEY_PEM=
