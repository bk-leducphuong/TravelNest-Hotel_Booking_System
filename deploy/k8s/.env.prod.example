# travelnest.prod
#
# Copy to deploy/k8s/.env.prod (gitignored) and fill in real values.
# deploy/scripts/secrets/seal-prod-secrets.sh renders the
# deploy/k8s/**/secret.template.yaml files with these variables and
# encrypts the result with SOPS.
#
# Every variable referenced by a secret.template.yaml must be present.
# Values may be blank for optional settings (e.g. SMTP_USER), but the
# variable itself must be defined.
#
# On AWS these connection settings come from `terraform output env_prod_hint`
# (see deploy/terraform/README.md). They are carried in the sealed Secret so
# the committed manifests stay environment-agnostic.

# --- Core database (RDS MySQL) ---
DB_HOST=travelnest-prod-mysql.xxxxxxxxxxxx.ap-southeast-1.rds.amazonaws.com
DB_PORT=3306
DB_PASSWORD=
DB_NAME=travelnest
DB_USER=travelnest

# --- Redis (ElastiCache) ---
REDIS_HOST=travelnest-prod-redis.xxxxxxxxxxxx.0001.apse1.cache.amazonaws.com
REDIS_PORT=6379
# Full URL for the analytics service (Go).
REDIS_URL=redis://travelnest-prod-redis.xxxxxxxxxxxx.0001.apse1.cache.amazonaws.com:6379/1

# --- API / sessions ---
JWT_SECRET=
SESSION_SECRET_KEY=
INTERNAL_SERVICE_TOKEN=

# --- MongoDB (managed) ---
MONGODB_URI=

# --- Object storage (AWS S3) ---
# Node services take a host + separate port.
MINIO_ENDPOINT=s3.ap-southeast-1.amazonaws.com
MINIO_PORT=443
MINIO_BUCKET=travelnest-media-xxxxxxxx
MINIO_USE_SSL=true
MINIO_REGION=ap-southeast-1
# The Go media service expects host:port in a single value.
MEDIA_MINIO_ENDPOINT=s3.ap-southeast-1.amazonaws.com:443
# Public/edge URL used to build object links (CloudFront or S3 endpoint).
PUBLIC_OBJECT_BASE_URL=
# IAM user access keys from `terraform output s3_access_key_id / s3_secret_access_key`.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- SMTP ---
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# --- Third-party APIs ---
EMAIL_VALIDATION_API_KEY=
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Elasticsearch (managed) ---
ELASTICSEARCH_ENDPOINT=
ELASTICSEARCH_HOSTS=
ELASTICSEARCH_API_KEY=

# --- Keycloak ---
KC_DB_URL_HOST=travelnest-prod-mysql.xxxxxxxxxxxx.ap-southeast-1.rds.amazonaws.com
KC_DB_URL_PORT=3306
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
# PEM-encoded public key (keep the \n escapes; do not wrap in quotes)
KEYCLOAK_PUBLIC_KEY_PEM=
