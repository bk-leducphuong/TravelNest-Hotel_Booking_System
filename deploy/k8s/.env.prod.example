# travelnest.prod — self-contained single-node k3s cluster (Hetzner CAX21)
#
# Copy to deploy/k8s/.env.prod (gitignored) and fill in real values.
# deploy/scripts/secrets/seal-prod-secrets.sh renders the
# deploy/k8s/**/overlays/prod/secret.template.yaml files with these variables
# and encrypts the result with SOPS.
#
# Every variable referenced by a secret.template.yaml must be present.
# Values may be blank for optional settings (e.g. SMTP_USER), but the
# variable itself must be defined.
#
# MySQL, Redis, MinIO, MongoDB and Keycloak run in-cluster (service DNS names
# below). Only Elasticsearch is external (Elastic Cloud).

# --- Core database (in-cluster MySQL) ---
DB_HOST=mysql
DB_PORT=3306
DB_PASSWORD=
DB_NAME=travelnest
DB_USER=travelnest

# --- Redis (in-cluster) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Full URL for the analytics service (Go). Must embed the password:
#   redis://:<REDIS_PASSWORD>@redis:6379/1
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/1

# --- API / sessions ---
JWT_SECRET=
SESSION_SECRET_KEY=
INTERNAL_SERVICE_TOKEN=

# --- MongoDB (in-cluster) ---
# Credentials for the app user provisioned by the mongodb PreSync bootstrap job.
MONGODB_USER=travelnest
MONGODB_PASSWORD=
# Must embed the credentials + authSource:
#   mongodb://<MONGODB_USER>:<MONGODB_PASSWORD>@mongodb:27017/travelnest_analytics?authSource=travelnest_analytics
MONGODB_URI=mongodb://travelnest:<MONGODB_PASSWORD>@mongodb:27017/travelnest_analytics?authSource=travelnest_analytics

# --- Object storage (in-cluster MinIO) ---
# Node services take a host + separate port.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=uploads
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
# The Go media service expects host:port in a single value.
MEDIA_MINIO_ENDPOINT=minio:9000
# Public/edge URL used to build object links (served through the Cloudflare Tunnel).
PUBLIC_OBJECT_BASE_URL=https://storage.deployserver.work/uploads
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- SMTP ---
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# --- Third-party APIs ---
EMAIL_VALIDATION_API_KEY=
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Elasticsearch (external, Elastic Cloud trial) ---
# https://<deployment-id>.<region>.aws.cloud.es.io
ELASTICSEARCH_ENDPOINT=
ELASTICSEARCH_HOSTS=
ELASTICSEARCH_API_KEY=

# --- Keycloak (in-cluster, backed by in-cluster MySQL) ---
KC_DB_URL_HOST=mysql
KC_DB_URL_PORT=3306
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# PEM-encoded public key (keep the \n escapes; do not wrap in quotes)
KEYCLOAK_PUBLIC_KEY_PEM=
