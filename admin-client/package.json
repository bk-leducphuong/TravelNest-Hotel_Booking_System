{
  "name": "@travelnest/admin-client",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx",
    "lint:fix": "eslint . --fix --ext .vue,.js,.ts,.jsx,.tsx",
    "typecheck": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:browser": "playwright test --config playwright.console.config.ts"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.3",
    "dotenv": "^17.3.1",
    "keycloak-js": "^26.2.5",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.6.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@element-plus/icons-vue": "^2",
    "@element-plus/nuxt": "^1.1.5",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@vue/compiler-dom": "^3.5",
    "@vue/test-utils": "^2.5.1",
    "element-plus": "^2.14.7",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.5",
    "happy-dom": "^20.7.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.1"
  }
}
